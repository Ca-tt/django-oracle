# Copy to the server as .env
DJANGO_SETTINGS_MODULE=django_store.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=zamovua.shop,www.zamovua.shop,localhost,127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DB_NAME=django_store
DB_USER=
DB_PASSWORD=
# Compose overrides this to the db service. localhost is for tools on the host.
DB_HOST=localhost
DB_PORT=5432

CSRF_TRUSTED_ORIGINS=https://zamovua.shop,https://www.zamovua.shop
