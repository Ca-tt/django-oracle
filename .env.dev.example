# dev locally, prod on the server
DJANGO_SETTINGS_MODULE=django_store.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DB_NAME=django_store
DB_USER=
DB_PASSWORD=
# Compose overrides this to the db service. localhost is for tools on the host.
DB_HOST=localhost
# Host port published by Compose. The web container is set back to 5432.
DB_PORT=5433

CSRF_TRUSTED_ORIGINS=http://localhost:8000
